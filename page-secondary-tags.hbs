{{!< default}}
<div class="gh-outer">
<main data-hub-locale="{{@custom.site_locale}}" class="site-main gh-inner">
    <section class="term">
        <h1 class="term-name">{{#match @custom.site_locale "ko"}}주제 태그{{else}}Topics{{/match}}</h1>
        <div class="term-description">{{#match @custom.site_locale "ko"}}사이트의 다양한 세부 주제를 확인하세요.{{else}}Explore supporting topics across the site.{{/match}}<br>{{#match @custom.site_locale "ko"}}카테고리와 시리즈 밖의 세부 주제를 살펴보세요.{{else}}Browse topics beyond categories and series.{{/match}}</div>
    </section>

    <section id="secondary-tags-featured" class="term term-tag-header secondary-tags-featured">{{#get "tags" filter="visibility:public+slug:-~^'category-'+slug:-~^'series-'" include="count.posts" order="count.posts desc,name asc" limit="1"}}
{{#foreach tags}}
{{#match count.posts ">" 0}}<div class="tag-header-image-wrap"><a href="{{url}}"><img class="tag-header-image" src="{{#if feature_image}}{{img_url feature_image size="s"}}{{else}}{{asset "images/fallback/secondary-tag-default.png"}}{{/if}}" alt="{{name}}"></a></div><div class="secondary-tags-featured-body"><h2 class="term-name"><a href="{{url}}">{{name}}</a></h2><div class="term-description">{{#if description}}{{description}}{{else}}{{#match @custom.site_locale "ko"}}가장 많이 사용된 주제의 글 모음{{else}}Most-used topic archive.{{/match}}{{/if}}</div></div>{{/match}}
{{else}}<p class="term-empty">{{#match @custom.site_locale "ko"}}아직 항목이 없습니다.{{else}}No items yet.{{/match}}</p>{{/foreach}}
{{/get}}</section>

    <section class="category-post-list secondary-tags-list" aria-label="{{#match @custom.site_locale "ko"}}주제 목록{{else}}Topics list{{/match}}">
        <h2 class="category-post-list-title">{{#match @custom.site_locale "ko"}}전체 주제 태그{{else}}All topics{{/match}}</h2>
        <div id="secondary-tags-grid" class="secondary-tags-grid">{{#get "tags" filter="visibility:public+slug:-~^'category-'+slug:-~^'series-'" include="count.posts" order="count.posts desc,name asc" limit="1"}}
{{#foreach tags}}
{{#match count.posts ">" 0}}{{> "hub-topic-pages" excludedId=id page=1}}{{/match}}
{{else}}<p class="term-empty">{{#match @custom.site_locale "ko"}}아직 항목이 없습니다.{{else}}No items yet.{{/match}}</p>{{/foreach}}
{{/get}}</div>
    </section>

</main>
</div>

