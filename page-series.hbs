{{!< default}}
<div class="gh-outer">
<main data-hub-locale="{{@custom.site_locale}}" class="site-main gh-inner">
    <section id="series-list-header" class="term term-tag-header">
        <div class="tag-header-image-wrap">
            <img class="tag-header-image" src="{{asset "images/hub/series-hero.png"}}" alt="{{#match @custom.site_locale "ko"}}시리즈{{else}}Series{{/match}}">
        </div>
        <h1 class="term-name">{{#match @custom.site_locale "ko"}}시리즈{{else}}Series{{/match}}</h1>
        <div class="term-description">{{#match @custom.site_locale "ko"}}긴 글과 연속된 주제별 시리즈를 확인하세요.{{else}}Collections of long-form essays and themed series.{{/match}}</div>
    </section>

    <section id="series-list-featured" class="category-featured" aria-label="{{#match @custom.site_locale "ko"}}대표 시리즈{{else}}Featured series{{/match}}">
        <h2 class="category-featured-title">{{#match @custom.site_locale "ko"}}대표 시리즈{{else}}Featured series{{/match}}</h2>
        <div id="series-featured-grid" class="post-feed gh-feed">{{#get "tags" filter="visibility:public+slug:~^'series-'" include="count.posts" order="count.posts desc,name asc" limit="1"}}
{{#foreach tags}}
{{> "hub-tag-card" fallback="images/fallback/series-tag-default.png" label="Series"}}
{{else}}<p class="term-empty">{{#match @custom.site_locale "ko"}}아직 항목이 없습니다.{{else}}No items yet.{{/match}}</p>{{/foreach}}
{{/get}}</div>
    </section>

    <section id="series-list-all" class="category-post-list" aria-label="{{#match @custom.site_locale "ko"}}시리즈 목록{{else}}Series list{{/match}}">
        <h2 class="category-post-list-title">{{#match @custom.site_locale "ko"}}전체 시리즈{{else}}All series{{/match}}</h2>
        <div id="series-list-grid" class="post-feed gh-feed js-promo-feed">{{#get "tags" filter="visibility:public+slug:~^'series-'" include="count.posts" order="count.posts desc,name asc" limit="1"}}
{{#foreach tags}}
{{#match count.posts ">" 0}}{{> "hub-series-pages" excludedId=id page=1}}{{/match}}
{{else}}<p class="term-empty">{{#match @custom.site_locale "ko"}}아직 항목이 없습니다.{{else}}No items yet.{{/match}}</p>{{/foreach}}
{{/get}}</div>
    </section>

    <nav id="series-list-pagination" class="ayu-pagination" aria-label="{{#match @custom.site_locale "ko"}}시리즈 페이지{{else}}Series pagination{{/match}}"></nav>

</main>
</div>


